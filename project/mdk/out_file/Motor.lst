   59          
   60          int16 motorPIDCalculate(PID_t *pid, int16 target, int16 actual) {
   61   1          int32 err, delta_err, delta2_err, delta_u;
   62   1      //    if (actual - target > 100) { //BangBang~
   63   1      //        gpio_set_level((gpio_pin_enum) pid->which ? motorDirR : motorDirL, 0);
   64   1      //        return c2;
   65   1      //    }
   66   1          err = target - actual;
   67   1          delta_err = err - pid->last_error;
   68   1          delta2_err = delta_err - (pid->last_error - pid->llast_error);
   69   1          delta_u = (int32) pid->Kp * delta_err +
   70   1                       (int32) pid->Ki * err +
   71   1                       (int32) pid->Kd * delta2_err;
   72   1          pid->llast_error = pid->last_error;
   73   1          pid->last_error = err;
   74   1          pid->base += delta_u / 100;
   75   1          pid->base = func_limit(pid->base, pid->max_out);
   76   1          gpio_set_level((gpio_pin_enum) pid->which ? motorDirR : motorDirL, pid->base >= 0);
   77   1          return func_abs(pid->base) + 200;
   78   1      }
