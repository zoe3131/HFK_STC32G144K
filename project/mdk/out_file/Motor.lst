   65   1          delta_u = (int32) pid->Kp * delta_err +
   66   1                       (int32) pid->Ki * err +
   67   1                       (int32) pid->Kd * (delta_err - (pid->last_error - pid->llast_error));
   68   1          pid->llast_error = pid->last_error;
