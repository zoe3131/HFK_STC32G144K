   70   1          pid->base += delta_u / 100;
   71   1          pid->base = func_limit(pid->base, pid->max_out);
   72   1          gpio_set_level((gpio_pin_enum) pid->which ? motorDirR : motorDirL, pid->base >= 0);
   73   1          return func_abs(pid->base);
   74   1      }
