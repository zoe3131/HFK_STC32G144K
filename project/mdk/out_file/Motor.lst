   49          int16 steerPIDCalculate(PID_t *pid, int16 error) {
   50   1          int32 p_term, d_term, att_term;
   51   1          int16 pid_output;
   52   1          p_term = (int32) pid->Kp * error;
   53   1          d_term = (int32) pid->Kd * (error - pid->last_error);
   54   1          att_term = (int32) pid->attitude_coeff * imu660rb_gyro_z;
   55   1          pid->last_error = error;
C251 COMPILER V5.60.0,  Motor                                                              10/07/26  17:10:19  PAGE 2   

   56   1          pid_output = (p_term + d_term + att_term) / 100;
   57   1          return func_limit(pid_output, pid->max_out);
   58   1      }
   59          
   60          int16 motorPIDCalculate(PID_t *pid, int16 target, int16 actual) {
   61   1          int32 err, delta_err, delta_u;
   62   1          err = target - actual;
   63   1          delta_err = err - pid->last_error;
   64   1          delta_u = (int32) pid->Kp * delta_err +
   65   1                       (int32) pid->Ki * err +
   66   1                       (int32) pid->Kd * delta_err - (pid->last_error - pid->llast_error);
   67   1          pid->llast_error = pid->last_error;
   68   1          pid->last_error = err;
   69   1          pid->base += delta_u / 100;
   70   1          pid->base = func_limit(pid->base, pid->max_out);
   71   1          gpio_set_level((gpio_pin_enum) pid->which ? motorDirR : motorDirL, pid->base >= 0);
   72   1          return func_abs(pid->base);
   73   1      }
