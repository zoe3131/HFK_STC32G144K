                 static void imu660rb_simspi_r_reg_byte(uint8 cmd, uint8 *val)
                 {
                   IMU660RB_SCK(0);
                   cmd |= IMU660RB_SPI_R;
                   imu660rb_simspi_wr_byte(cmd);
                   *val = imu660rb_simspi_wr_byte(0);
                   IMU660RB_SCK(1);
                 }
                 
               
