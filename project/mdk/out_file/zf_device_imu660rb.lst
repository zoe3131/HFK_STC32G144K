                 static void imu660rb_simspi_r_reg_bytes(uint8 cmd, uint8 *val, uint32 num)
                 {
                   cmd |= IMU660RB_SPI_R;
                   imu660rb_simspi_wr_byte(cmd);
                   while(num--)
