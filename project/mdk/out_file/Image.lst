  407   2              idx1 = func_limit_ab(i - 2, 0, count - 1);
  408   2              idx2 = func_limit_ab(i + 2, 0, count - 1);
  409   2              dx = roadLine[idx2].x - roadLine[idx1].x;
  410   2              dy = roadLine[idx2].y - roadLine[idx1].y;
  411   2              dn = sqrt_int(dx * dx + dy * dy);
  412   2              if (!dn) continue;
